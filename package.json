{
  "name": "vyzium-gestao-operacional",
  "version": "3.3.9",
  "description": "Vyzium 3.3.9: interface operacional, sidebar recolhível, fornecedores compartilhados em Compras e prazo opcional dos mapas.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:backend": "python -m unittest discover -s backend -p \"test_*.py\" -v",
    "verify:whatsapp-patch": "node scripts/verify-whatsapp-patch.js",
    "diagnose:whatsapp": "node scripts/diagnose-whatsapp.js",
    "build": "electron-builder --win nsis --x64 --publish never",
    "test:node": "node --test tests/quote-send.cjs tests/supplier-contacts.cjs tests/whatsapp-lifecycle.cjs tests/diagnostics.cjs tests/sentry.cjs tests/whatsapp.cjs tests/whatsapp-patch.cjs tests/remote-backup.cjs tests/updates.cjs tests/purchase-model.cjs tests/project-config.cjs tests/security.cjs tests/security-manager.cjs tests/auth-manager.cjs tests/firebase.cjs tests/operational-ui.cjs && node tests/sort.cjs",
    "test": "npm run test:backend && npm run test:node",
    "test:whatsapp-browser": "node --test tests/whatsapp-browser.cjs"
  },
  "dependencies": {
    "whatsapp-web.js": "1.34.7",
    "qrcode": "1.5.4",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "39.0.0",
    "electron-builder": "26.0.0"
  },
  "build": {
    "appId": "com.vyzium.gestaooperacional",
    "productName": "Vyzium",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-engine",
        "to": "backend",
        "filter": [
          "followup-engine.exe",
          "compras-engine.exe"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp"
    },
    "artifactName": "Vyzium-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "solucionx",
        "repo": "Vyzium-Releases",
        "releaseType": "draft"
      }
    ],
    "asarUnpack": [
      "electron/whatsapp-hidden-browser.ps1"
    ]
  },
  "author": "Solucionx",
  "repository": {
    "type": "git",
    "url": "https://github.com/solucionx/Vyzium.git"
  }
}
