{
  "name": "vyzium-gestao-operacional",
  "version": "1.2.10",
  "description": "Controle visual e follow-up autom\u00e1tico de ordens de compra com Electron e motor Python.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:backend": "python -m unittest discover -s backend -p \"test_*.py\" -v",
    "build": "electron-builder --win nsis --x64 --publish never",
    "test:node": "node --test tests/whatsapp.cjs tests/updates.cjs && node tests/sort.cjs",
    "test": "npm run test:backend && npm run test:node"
  },
  "dependencies": {
    "whatsapp-web.js": "1.34.7",
    "qrcode": "1.5.4",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "39.0.0",
    "electron-builder": "26.0.0"
  },
  "build": {
    "appId": "com.vyzium.gestaooperacional",
    "productName": "Vyzium",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-engine",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Vyzium-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "solucionx",
        "repo": "Vyzium",
        "releaseType": "draft"
      }
    ]
  },
  "author": "Solucionx",
  "repository": {
    "type": "git",
    "url": "https://github.com/solucionx/Vyzium.git"
  }
}
