name: Microsoft Store Package

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  store-package:
    runs-on: windows-latest
    env:
      PUPPETEER_SKIP_DOWNLOAD: "true"
      CSC_IDENTITY_AUTO_DISCOVERY: "false"
      VYZIUM_APP_VERSION: "3.2.1"

    steps:
      - name: Baixar codigo
        uses: actions/checkout@v4

      - name: Verificar seguranca do repositorio
        shell: pwsh
        run: ./scripts/verify-repository-safety.ps1

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm

      - name: Configurar Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: backend/requirements.txt

      - name: Validar identidade da Store
        shell: pwsh
        run: |
          $cfg = Get-Content electron-builder.store.yml -Raw
          if ($cfg -notmatch 'identityName: Solucionx.Vyzium') { throw 'Identity Name da Store divergente.' }
          if ($cfg -notmatch 'CN=B0BDB428-BDCB-4054-A750-186A5394F35E') { throw 'Publisher da Store divergente.' }
          if ($cfg -notmatch 'publisherDisplayName: Solucionx') { throw 'PublisherDisplayName da Store divergente.' }
          $version = (Get-Content package.json | ConvertFrom-Json).version
          if ($version -ne '3.2.1') { throw "Versao inesperada: $version" }

      - name: Instalar dependencias Node
        run: npm ci

      - name: Verificar patch do WhatsApp
        run: npm run verify:whatsapp-patch

      - name: Instalar dependencias Python
        run: python -m pip install -r backend/requirements.txt

      - name: Executar testes
        run: npm test

      - name: Compilar motor de Acompanhamento
        run: >
          python -m PyInstaller
          --noconfirm
          --clean
          --onefile
          --name followup-engine
          --collect-all openpyxl
          --collect-all sqlcipher3
          --distpath dist-engine
          --workpath build/pyinstaller-followup-store
          backend/engine.py

      - name: Compilar motor de Cotacao e Mapas
        run: >
          python -m PyInstaller
          --noconfirm
          --clean
          --onefile
          --name compras-engine
          --collect-all openpyxl
          --collect-all sqlcipher3
          --hidden-import xlrd
          --hidden-import xlwt
          --distpath dist-engine
          --workpath build/pyinstaller-compras-store
          backend/compras_engine.py

      - name: Verificar motores
        shell: pwsh
        run: ./scripts/verify-engines.ps1

      - name: Gerar pacote Microsoft Store (AppX x64)
        shell: pwsh
        run: npx electron-builder --win appx --x64 --config electron-builder.store.yml --publish never

      - name: Validar pacote e identidade
        shell: pwsh
        run: |
          $pkg = Get-ChildItem dist-store -Filter *.appx | Select-Object -First 1
          if (-not $pkg) { throw 'Pacote AppX nao foi gerado.' }
          Write-Host "Pacote: $($pkg.FullName)"

          $kitRoot = 'C:\Program Files (x86)\Windows Kits\10\bin'
          $makeappx = Get-ChildItem $kitRoot -Recurse -Filter makeappx.exe -ErrorAction Stop |
            Where-Object { $_.FullName -match '\\x64\\makeappx\.exe$' } |
            Sort-Object FullName -Descending |
            Select-Object -First 1
          if (-not $makeappx) { throw 'makeappx.exe nao encontrado no runner.' }

          $unpack = Join-Path $env:RUNNER_TEMP 'vyzium-appx-unpack'
          if (Test-Path $unpack) { Remove-Item $unpack -Recurse -Force }
          & $makeappx.FullName unpack /p $pkg.FullName /d $unpack /o
          if ($LASTEXITCODE -ne 0) { throw 'Falha ao desempacotar o AppX para validacao.' }

          [xml]$manifest = Get-Content (Join-Path $unpack 'AppxManifest.xml')
          $identity = $manifest.Package.Identity
          if ($identity.Name -ne 'Solucionx.Vyzium') { throw "Identity.Name incorreto: $($identity.Name)" }
          if ($identity.Publisher -ne 'CN=B0BDB428-BDCB-4054-A750-186A5394F35E') { throw "Identity.Publisher incorreto: $($identity.Publisher)" }
          if ($identity.ProcessorArchitecture -ne 'x64') { throw "Arquitetura incorreta: $($identity.ProcessorArchitecture)" }
          if (-not ($identity.Version -like '3.2.1.*')) { throw "Versao do pacote inesperada: $($identity.Version)" }

          $follow = Get-ChildItem $unpack -Recurse -Filter followup-engine.exe | Select-Object -First 1
          $compras = Get-ChildItem $unpack -Recurse -Filter compras-engine.exe | Select-Object -First 1
          if (-not $follow -or -not $compras) { throw 'Motores Python ausentes no pacote Store.' }
          if ($follow.Length -lt 1MB -or $compras.Length -lt 1MB) { throw 'Motor Python empacotado parece incompleto.' }

          Write-Host "STORE PACKAGE OK: $($pkg.Name)"
          Write-Host "Version: $($identity.Version)"
          Write-Host "Publisher: $($identity.Publisher)"

      - name: Guardar pacote da Microsoft Store
        uses: actions/upload-artifact@v4
        with:
          name: Vyzium-Store-3.2.1-x64
          path: dist-store/*.appx
          if-no-files-found: error
